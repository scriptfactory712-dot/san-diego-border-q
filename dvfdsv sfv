                local success, err = pcall(farmCycle)
                if not success then
                    Notify("Error", "Farm error: " .. tostring(err), 3)
                    warn("[AutoFarm Error]", err)
                end
                
                if autoFarmEnabled then
                    task.wait(2)
                end
            end
            farmThread = nil
        end)
    end

    local function stopAutoFarm()
        autoFarmEnabled = false
        if farmThread then
            task.cancel(farmThread)
            farmThread = nil
        end
