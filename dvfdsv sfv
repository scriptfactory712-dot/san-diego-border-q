            return false 
        end
        hrp.CFrame = CFrame.new(position)
        return true
    end

    -- Поиск ProximityPrompt по названию
    local function findProximityPrompt(targetName, range)
        range = range or 50
        
        -- Ищем в Workspace
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local promptName = obj.Name
                local parentName = obj.Parent and obj.Parent.Name or ""
                
                -- Проверяем имя промпта или родителя
                if promptName:lower():find(targetName:lower()) or 
                   parentName:lower():find(targetName:lower()) then
                    
                    local promptPos = obj.Parent and obj.Parent:IsA("BasePart") and obj.Parent.Position or nil
                    if promptPos and (hrp.Position - promptPos).Magnitude <= range then
                        return obj
                    end
                end
            end
        end
        
        -- Ищем по позиции (если название не найдено)
        local hrp = getHRP()
        if hrp then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent:IsA("BasePart") then
                    local dist = (hrp.Position - obj.Parent.Position).Magnitude
                    if dist <= range then
                        return obj
                    end
                end
            end
        end
        
        return nil
    end

    -- Взаимодействие с ProximityPrompt
    local function interactWithPrompt(prompt)
        if not prompt then return false end
        
        if fireproximityprompt then
            pcall(fireproximityprompt, prompt)
            return true
        elseif prompt.TriggerDistance then
            -- Альтернативный метод
            local hrp = getHRP()
            if hrp then
                local oldPos = hrp.CFrame
                hrp.CFrame = prompt.Parent.CFrame * CFrame.new(0, 2, 0)
                task.wait(0.2)
                hrp.CFrame = oldPos
                return true
            end
        end
        
        return false
    end

    -- Покупка предмета
    local function buyItem(itemName)
        Notify("Farm", "Buying: " .. itemName, 2)
        
        -- Телепортируемся к магазину
        teleportTo(SHOP_COORDS)
        task.wait(0.5)
        
        -- Ищем предмет в магазине
        local itemData = nil
        for _, item in pairs(ITEMS) do
            if item.name == itemName then
                itemData = item
                break
            end
        end
        
        if itemData then
            teleportTo(itemData.pos)
            task.wait(0.3)
        end
        
        -- Ищем ProximityPrompt для покупки
        local prompt = findProximityPrompt(itemName, 30)
        if not prompt then
            prompt = findProximityPrompt("Shop", 30)
        end
        if not prompt then
            prompt = findProximityPrompt("Buy", 30)
        end
        
        if prompt then
            interactWithPrompt(prompt)
            task.wait(1.5)
            
            -- Проверяем купили ли предмет
            if hasItem(itemName) then
                Notify("Farm", "Successfully bought " .. itemName, 2)
                return true
            else
                Notify("Farm", "Waiting for item...", 2)
                task.wait(2)
                return hasItem(itemName)
            end
        else
            Notify("Farm", "No shop prompt found! Trying alternative...", 2)
            -- Пробуем просто ждать (иногда предмет покупается автоматически)
            task.wait(2)
            return hasItem(itemName)
        end
    end

    -- Продажа продавцу
    local function sellToSeller()
        Notify("Farm", "Going to seller...", 2)
        
        -- Проверяем есть ли предмет для продажи
        local hasAnyItem = false
        for _, item in pairs(ITEMS) do
            if hasItem(item.name) then
                hasAnyItem = true
                break
            end
        end
        
        if not hasAnyItem then
            Notify("Farm", "No items to sell!", 2)
            return false
        end
        
        -- Летим по маршруту к продавцу
        for i, point in pairs(ROUTE_TO_SELLER) do
            if not autoFarmEnabled then return false end
            teleportTo(point)
            task.wait(teleportSpeed)
        end
        
        -- Телепортируемся к продавцу
        teleportTo(SELLER_COORDS)
        task.wait(0.5)
        
        -- Ищем ProximityPrompt продавца
        local prompt = findProximityPrompt("Seller", 30)
        if not prompt then
            prompt = findProximityPrompt("Smuggled", 30)
        end
        if not prompt then
            prompt = findProximityPrompt("Sell", 30)
        end
        if not prompt then
            prompt = findProximityPrompt("Goods", 30)
        end
        
        if prompt then
            interactWithPrompt(prompt)
            task.wait(1.5)
            Notify("Farm", "Sold items!", 2)
            return true
        else
            Notify("Farm", "No seller prompt found!", 2)
            task.wait(1)
            return false
        end
    end

