    -- Полный цикл фарма
    local function farmCycle()
        local hrp = getHRP()
        if not hrp then
            Notify("Error", "Character not loaded!", 3)
            return
        end
        
        -- 1. Телепортируемся к старту
        teleportTo(POINT_1)
        task.wait(1)
        
        -- 2. Покупаем выбранный предмет
        local bought = buyItem(selectedItem)
        if not bought then
            Notify("Farm", "Failed to buy " .. selectedItem .. " - retrying...", 3)
            task.wait(1)
            bought = buyItem(selectedItem)
        end
        
        if not bought then
            Notify("Farm", "Still failed to buy - skipping cycle", 3)
            return
        end
        
        -- 3. Продаём продавцу
        local sold = sellToSeller()
        if not sold then
            Notify("Farm", "Failed to sell - retrying...", 3)
            task.wait(1)
            sold = sellToSeller()
        end
        
        if not sold then
            Notify("Farm", "Still failed to sell - trying to wash anyway", 3)
        end
        
        -- 4. Отмываем деньги
        local washed = washMoney()
        if washed then
            Notify("Farm", "✓ Cycle complete!", 3)
        else
            Notify("Farm", "Cycle finished with errors", 3)
        end
    end

    -- Запуск автофарма
    local function startAutoFarm()
        if farmThread then return end
        
